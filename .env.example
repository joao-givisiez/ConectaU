# Variáveis do Docker Compose. Copie para .env e troque TODOS os valores antes de subir:
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (bash)
# O .env é ignorado pelo Git; este arquivo de exemplo não contém segredos reais.

# --- Senhas dos bancos (uma instância por serviço) ---
IDENTIDADE_DB_SENHA=troque-identidade
COLETA_DB_SENHA=troque-coleta
COLETA_DB_SENHA_ROOT=troque-coleta-root
OPORTUNIDADES_DB_SENHA=troque-oportunidades
OPORTUNIDADES_LEITURA_DB_SENHA=troque-oportunidades-leitura
ENGAJAMENTO_DB_SENHA=troque-engajamento
ASSISTENTE_DB_SENHA=troque-assistente

# --- Mensageria ---
RABBITMQ_USUARIO=conectau
RABBITMQ_SENHA=troque-rabbitmq

# --- Segredos de aplicação ---
# Segredo de assinatura do JWT: só a Identidade o conhece. Use 32+ caracteres aleatórios.
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
# Segredo compartilhado entre serviços para as rotas /internal/**.
TOKEN_SERVICO=troque-por-outro-segredo-longo

# --- Administrador inicial (criado pela Identidade na primeira subida) ---
ADMIN_EMAIL=admin@conectau.local
ADMIN_SENHA=troque-a-senha-do-admin

# --- Demonstração da SAGA: true faz a indexação no Assistente falhar (compensação) ---
SIMULAR_FALHA_INDEXACAO=false

# --- LLM do Assistente (Groq) ---
# Única variável que precisa ser preenchida para ativar as respostas geradas pelo modelo.
# Crie a chave em https://console.groq.com/keys. Sem ela, o assistente responde em modo de
# recuperação (trechos relevantes, sem texto gerado) e todo o resto do sistema funciona normalmente.
GROQ_API_KEY=
# Modelo (opcional). Confira os modelos e preços vigentes em https://console.groq.com/docs/models
#GROQ_MODELO=openai/gpt-oss-120b
# Só para testes sem gastar tokens: aponta para o simulador local (node scripts/groq-simulado.mjs)
#GROQ_BASE_URL=http://host.docker.internal:4010
