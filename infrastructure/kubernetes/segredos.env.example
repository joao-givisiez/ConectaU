# Segredos do Kubernetes: o kustomization.yaml gera o Secret conectau-segredos a partir deste arquivo.
# Copie para segredos.env e troque TODOS os valores antes de aplicar:
#   Copy-Item infrastructure/kubernetes/segredos.env.example infrastructure/kubernetes/segredos.env
#   cp infrastructure/kubernetes/segredos.env.example infrastructure/kubernetes/segredos.env
# O segredos.env é ignorado pelo Git; este arquivo de exemplo não contém segredos reais.

# --- Senhas dos bancos (uma instância por serviço) ---
IDENTIDADE_DB_SENHA=troque-identidade
COLETA_DB_SENHA=troque-coleta
COLETA_DB_SENHA_ROOT=troque-coleta-root
OPORTUNIDADES_DB_SENHA=troque-oportunidades
OPORTUNIDADES_LEITURA_DB_SENHA=troque-oportunidades-leitura
ENGAJAMENTO_DB_SENHA=troque-engajamento
ASSISTENTE_DB_SENHA=troque-assistente

# --- Mensageria ---
RABBITMQ_USUARIO=conectau
RABBITMQ_SENHA=troque-rabbitmq

# --- Segredos de aplicação ---
# Segredo de assinatura do JWT: só a Identidade o conhece. Use 32+ caracteres aleatórios.
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
# Segredo compartilhado entre serviços para as rotas /internal/**.
TOKEN_SERVICO=troque-por-outro-segredo-longo

# --- Administrador inicial (criado pela Identidade na primeira subida) ---
ADMIN_EMAIL=admin@conectau.local
ADMIN_SENHA=troque-a-senha-do-admin

