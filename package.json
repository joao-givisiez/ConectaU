{
  "name": "conectau",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma ConectaU - Sistema distribuído de oportunidades universitárias",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:identidade": "npm run dev --workspace=@conectau/identidade",
    "dev:coleta": "npm run dev --workspace=@conectau/coleta",
    "dev:oportunidades": "npm run dev --workspace=@conectau/oportunidades",
    "dev:engajamento": "npm run dev --workspace=@conectau/engajamento",
    "dev:assistente": "npm run dev --workspace=@conectau/assistente",
    "dev:bff-web": "npm run dev --workspace=@conectau/bff-web",
    "dev:bff-admin": "npm run dev --workspace=@conectau/bff-admin"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "bffs/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joao-givisiez/ConectaU.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
